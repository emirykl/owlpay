NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# Allowed frontend origins for CORS. Comma-separated for multiple origins.
# Local development: http://localhost:3000
# Browser origins allowed to call this API. Comma separated, matched exactly.
# Vercel: set to your frontend deployment URL (e.g. https://owlpay-xxx.vercel.app)
# Multiple: https://owlpay.vercel.app,https://owlpay-git-main-xxx.vercel.app
# There is no wildcard for preview deployments on purpose: anyone can register
# any <name>.vercel.app, so a preview URL that needs API access must be listed
# here by hand. Prefer a stable alias domain over per-commit preview URLs.
FRONTEND_ORIGIN=http://localhost:3000

# Persistence: memory is local-only; use supabase for shared/testnet deployments.
PERSISTENCE_MODE=memory
SUPABASE_URL=
SUPABASE_SECRET_KEY=
AGENT_API_KEY=

# GOAT Testnet3
GOAT_CHAIN_ID=48816
GOAT_RPC_URL=https://rpc.testnet3.goat.network
GOAT_EXPLORER_URL=https://explorer.testnet3.goat.network
OWL_PAY_CONTRACT_ADDRESS=
PAYMENT_TOKEN_ADDRESS=
PAYMENT_TOKEN_SYMBOL=USDC
PAYMENT_TOKEN_DECIMALS=6
PLATFORM_TREASURY_ADDRESS=
PLATFORM_FEE_BPS=300

# One-time review products paid by the repository owner (6-decimal test token).
STANDARD_REVIEW_PRICE=1
SECURITY_REVIEW_PRICE=2

# Keep false until a reviewed testnet contract is deployed.
ENABLE_TESTNET_WRITES=false
SETTLEMENT_PRIVATE_KEY=

# Deployment-only values. Use a dedicated testnet wallet; never commit its key.
DEPLOYER_PRIVATE_KEY=
SETTLEMENT_AGENT_ADDRESS=

# Optional GitHub token for higher API rate limits. Never expose it to frontend.
GITHUB_TOKEN=

# Owl Agent reviews run server-side through the OpenAI Responses API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_REVIEW_MAX_DIFF_CHARACTERS=60000

# Vercel sends this value as Authorization: Bearer <secret> to the cron route.
# Use a random value of at least 16 characters in production.
CRON_SECRET=

# This interval is only for local development or persistent Node.js hosts.
# Vercel skips it and calls /api/cron/resolve-due from vercel.json instead.
ENABLE_RESOLUTION_WORKER=true
RESOLUTION_WORKER_INTERVAL_MS=60000

# GOAT Flow/x402 merchant details are environment-specific.
GOAT_FLOW_API_URL=https://flow-api.testnet3.goat.network
GOAT_FLOW_MERCHANT_ID=
GOAT_FLOW_API_KEY=
GOAT_FLOW_API_SECRET=
GOAT_FLOW_TOKEN_SYMBOL=USDC
GOAT_FLOW_TOKEN_ADDRESS=
GOAT_FLOW_TOKEN_DECIMALS=6
