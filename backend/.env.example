NODE_ENV=development
PORT=4000
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:3000

# Persistence: memory is local-only; use supabase for shared/testnet deployments.
PERSISTENCE_MODE=memory
SUPABASE_URL=
SUPABASE_SECRET_KEY=
AGENT_API_KEY=

# GOAT Testnet3
GOAT_CHAIN_ID=48816
GOAT_RPC_URL=https://rpc.testnet3.goat.network
GOAT_EXPLORER_URL=https://explorer.testnet3.goat.network
OWL_PAY_CONTRACT_ADDRESS=
PAYMENT_TOKEN_ADDRESS=
PLATFORM_TREASURY_ADDRESS=
PLATFORM_FEE_BPS=300

# One-time review products paid by the repository owner (6-decimal test token).
STANDARD_REVIEW_PRICE=2
SECURITY_REVIEW_PRICE=5

# Keep false until a reviewed testnet contract is deployed.
ENABLE_TESTNET_WRITES=false
SETTLEMENT_PRIVATE_KEY=

# Deployment-only values. Use a dedicated testnet wallet; never commit its key.
DEPLOYER_PRIVATE_KEY=
SETTLEMENT_AGENT_ADDRESS=

# Optional GitHub token for higher API rate limits. Never expose it to frontend.
GITHUB_TOKEN=

# GOAT Flow/x402 merchant details are environment-specific.
GOAT_FLOW_API_URL=https://flow-api.testnet3.goat.network
GOAT_FLOW_MERCHANT_ID=
GOAT_FLOW_API_KEY=
