{
  "name": "owlpay-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "contract:compile": "hardhat compile",
    "contract:test": "hardhat test",
    "contract:deploy:testnet": "hardhat run scripts/deploy.cjs --network goatTestnet"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@openzeppelin/contracts": "^5.4.0",
    "@supabase/supabase-js": "^2.112.0",
    "dotenv": "^17.2.1",
    "fastify": "^5.5.0",
    "viem": "^2.33.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@types/node": "^24.1.0",
    "eslint": "^9.32.0",
    "hardhat": "^2.26.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
